<package format="3">
  <name>vehicle_simulator</name>
  <version>0.0.1</version>
  <description>Vehicle Simulator</description>
  <maintainer email="zhangji@cmu.edu">Ji Zhang</maintainer>
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  
  <depend>rclcpp</depend>
  <depend>std_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>pcl_ros</depend>
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>
  <depend>message_filters</depend>
  <depend>pcl_conversions</depend>
  <depend>ros_tcp_endpoint</depend>
  <depend>cv_bridge</depend>

  <!-- Runtime dependencies used by the composed system launch files. -->
  <exec_depend>fast_lio</exec_depend>
  <exec_depend>fast_lio_vehicle_adapter</exec_depend>
  <exec_depend>far_planner</exec_depend>
  <exec_depend>joy</exec_depend>
  <exec_depend>livox_ros_driver2</exec_depend>
  <exec_depend>local_planner</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>sensor_scan_generation</exec_depend>
  <exec_depend>terrain_analysis</exec_depend>
  <exec_depend>terrain_analysis_ext</exec_depend>
  <exec_depend>teleop_rviz_plugin</exec_depend>
  <exec_depend>visualization_tools</exec_depend>
  <exec_depend>waypoint_rviz_plugin</exec_depend>
  
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_model_path="${prefix}/mesh"/>
  </export>
</package>
